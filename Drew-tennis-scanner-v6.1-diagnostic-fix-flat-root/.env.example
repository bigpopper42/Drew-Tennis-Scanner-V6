# Required
API_TENNIS_KEY=replace_me
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current Supabase server-side key
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative. Use only one of the two Supabase key variables.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Worker settings
TIMEZONE=America/Phoenix
SCAN_INTERVAL_SECONDS=30
SHADOW_BANKROLL=100
DRY_RUN=false
# true = store TRADE and NO TRADE evaluations for debugging
SAVE_ALL_SCANS=false

# Network and caching controls
FIXTURES_FALLBACK_INTERVAL_SECONDS=300
RANKINGS_REFRESH_SECONDS=21600
MARKET_CACHE_TTL_SECONDS=1800
UNMATCHED_RETRY_SECONDS=300
MARKET_SEARCH_PAGES=2
MIN_MARKET_CONFIDENCE=80
MAX_EVENTS_PER_CYCLE=0
MAX_PENDING_RECORDS=5000
