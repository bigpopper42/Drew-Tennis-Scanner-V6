# Required
API_TENNIS_KEY=replace_me
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current Supabase server-side key
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative. Use only one of the two Supabase key variables.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Worker settings
TIMEZONE=America/Phoenix
SCAN_INTERVAL_SECONDS=30
SHADOW_BANKROLL=100
DRY_RUN=false
# true = store TRADE and NO TRADE evaluations for debugging
SAVE_ALL_SCANS=false

# Network and caching controls
FIXTURES_FALLBACK_INTERVAL_SECONDS=300
RANKINGS_REFRESH_SECONDS=21600
MARKET_CACHE_TTL_SECONDS=1800
UNMATCHED_RETRY_SECONDS=300
MARKET_SEARCH_PAGES=2
MIN_MARKET_CONFIDENCE=80
MAX_EVENTS_PER_CYCLE=0
MAX_PENDING_RECORDS=5000

# Discord trade notifications
DISCORD_NOTIFICATIONS=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
# Sends one connection confirmation whenever the Railway worker starts.
DISCORD_STARTUP_ALERTS=true

# Polymarket US automatic execution
# Keep false until every value below is configured in Railway.
POLYMARKET_EXECUTION_ENABLED=false
POLYMARKET_KEY_ID=replace_with_key_id
POLYMARKET_SECRET_KEY=replace_with_secret_key

# Locked live sizing and safeguards
# Version 6.5.8 uses 20% in code. Legacy EXECUTION_BANKROLL_PCT and
# EXECUTION_MAX_ORDER_USD variables are ignored.
EXECUTION_MIN_ORDER_USD=0.50
EXECUTION_MIN_PRICE_CENTS=50
EXECUTION_MAX_PRICE_CENTS=99
EXECUTION_SLIPPAGE_TICKS=1
EXECUTION_MIN_MARKET_CONFIDENCE=80
